rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ─────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isActive(uid) {
      return userDoc(uid).status == 'active';
    }

    function isChatParticipant(chatData) {
      return request.auth.uid in chatData.participants;
    }

    function chatIsNotExpired(chatData) {
      return chatData.status == 'unlocked'
          || (chatData.expiresAt is timestamp && chatData.expiresAt > request.time);
    }

    function withinDailyMessageLimit(uid) {
      let u = userDoc(uid);
      return u.get('unlimitedChat', false) == true || u.dailyMessageCount < 20;
    }

    function validTags(tags) {
      return tags is list && tags.size() >= 3 && tags.size() <= 7;
    }

    function validUsername(name) {
      return name is string && name.size() >= 3 && name.size() <= 20;
    }


    // ─────────────────────────────────────────────
    // /users/{uid}
    // ─────────────────────────────────────────────
    match /users/{uid} {

      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.status == 'active'
                    && request.resource.data.reportCount == 0
                    && request.resource.data.dailyMessageCount == 0
                    && request.resource.data.isGhostMode == false;

      allow update: if isSignedIn()
                    && isOwner(uid)
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['reportCount', 'status', 'uid'])
                      ||
                      (
                        request.resource.data.dailyMessageCount == resource.data.dailyMessageCount + 1
                        && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['reportCount', 'status', 'uid'])
                      )
                    );

      allow delete: if false;
    }


    // ─────────────────────────────────────────────
    // /swipes/{swipeId}
    // ─────────────────────────────────────────────
    match /swipes/{swipeId} {

      allow read: if isSignedIn()
                  && (resource == null
                   || resource.data.swiperId == request.auth.uid
                   || resource.data.targetId == request.auth.uid);

      allow create: if isSignedIn()
                    && request.resource.data.swiperId == request.auth.uid
                    && isActive(request.auth.uid)
                    && request.resource.data.type in ['like', 'pass']
                    && request.resource.data.keys().hasAll(['swiperId', 'targetId', 'type', 'timestamp'])
                    && swipeId == request.resource.data.swiperId + '_' + request.resource.data.targetId;

      allow update: if false;
      allow delete: if false;
    }


    // ─────────────────────────────────────────────
    // /chats/{chatId}
    // ─────────────────────────────────────────────
    match /chats/{chatId} {

      allow read: if isSignedIn()
                  && (resource == null || isChatParticipant(resource.data));

      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && request.resource.data.status in ['active', 'unlocked']
                    && request.resource.data.messageCount == 0
                    && request.resource.data.keys().hasAll([
                        'participants', 'createdAt', 'expiresAt',
                        'status', 'messageCount'
                       ]);

      // Participants can update: status, message metadata, typing map, and last message preview
      allow update: if isSignedIn()
                    && isChatParticipant(resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly([
                          'status',
                          'verdicts',
                          'lastMessageTimestamp',
                          'lastMessageSenderId',
                          'lastMessagePreview',
                          'messageCount',
                          'typing'
                        ])
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
                      || (resource.data.status == 'active'
                          && request.resource.data.status in ['unlocked', 'expired'])
                      || resource.data.status == 'unlocked'
                    );

      allow delete: if false;


      // ─────────────────────────────────────────────
      // /chats/{chatId}/messages/{messageId}
      // ─────────────────────────────────────────────
      match /messages/{messageId} {

        allow read: if isSignedIn()
                    && isChatParticipant(
                         get(/databases/$(database)/documents/chats/$(chatId)).data
                       );

        allow create: if isSignedIn()
                      && request.resource.data.senderId == request.auth.uid
                      && isActive(request.auth.uid)
                      && isChatParticipant(
                           get(/databases/$(database)/documents/chats/$(chatId)).data
                         )
                      && chatIsNotExpired(
                           get(/databases/$(database)/documents/chats/$(chatId)).data
                         )
                      && withinDailyMessageLimit(request.auth.uid)
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500
                      && request.resource.data.keys().hasAll(['senderId', 'text', 'timestamp']);

        // Allow participants to update only the reactions map (emoji reactions)
        allow update: if isSignedIn()
                      && isChatParticipant(
                           get(/databases/$(database)/documents/chats/$(chatId)).data
                         )
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['reactions']);

        allow delete: if false;
      }
    }


    // ─────────────────────────────────────────────
    // /reports/{reportId}
    // ─────────────────────────────────────────────
    match /reports/{reportId} {

      allow read: if false;

      allow create: if isSignedIn()
                    && isActive(request.auth.uid)
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.reportedId != request.auth.uid
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() > 0
                    && request.resource.data.keys().hasAll([
                        'reporterId', 'reportedId', 'reason', 'timestamp'
                       ]);

      allow update: if false;
      allow delete: if false;
    }


    // ─────────────────────────────────────────────
    // /happyHourQueue/{docId}
    // ─────────────────────────────────────────────
    match /happyHourQueue/{docId} {

      allow read: if isSignedIn();

      allow create, update: if isSignedIn()
                             && isActive(request.auth.uid);

      allow delete: if false;
    }


    // ─────────────────────────────────────────────
    // /settings/{docId}
    // Admin-writable global settings (e.g. Happy Hour time)
    // ─────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.token.email == 'officialzed.10@gmail.com';
    }


    // ─────────────────────────────────────────────
    // /rooms/{roomId}/messages/{messageId}
    // Public tag-based rooms — any active signed-in user can read/write
    // ─────────────────────────────────────────────
    match /rooms/{roomId} {

      allow read: if isSignedIn();

      match /messages/{messageId} {

        // Any active user can read room messages
        allow read: if isSignedIn();

        // Any active user can post to a room
        allow create: if isSignedIn()
                      && isActive(request.auth.uid)
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 400
                      && request.resource.data.keys().hasAll([
                           'senderId', 'username', 'avatarUrl', 'text', 'timestamp'
                         ]);

        // Room messages are immutable
        allow update: if false;
        allow delete: if false;
      }
    }

  }
}
