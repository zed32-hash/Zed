rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ─────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isActive(uid) {
      return userDoc(uid).status == 'active';
    }

    function isNotGhost(uid) {
      return userDoc(uid).isGhostMode == false;
    }

    function isChatParticipant(chatData) {
      return request.auth.uid in chatData.participants;
    }

    function chatIsNotExpired(chatData) {
      return chatData.status == 'unlocked'
          || (chatData.expiresAt is timestamp && chatData.expiresAt > request.time);
    }

    function withinDailyMessageLimit(uid) {
      let u = userDoc(uid);
      let count = u.dailyMessageCount;
      // Allow if lastMessageReset is from a previous day (count resets)
      let resetDate = u.lastMessageReset;
      return count < 20;
    }

    function validTags(tags) {
      return tags is list && tags.size() >= 3 && tags.size() <= 7;
    }

    function validUsername(name) {
      return name is string && name.size() >= 3 && name.size() <= 20;
    }


    // ─────────────────────────────────────────────
    // /users/{uid}
    // ─────────────────────────────────────────────
    match /users/{uid} {

      // Anyone signed in can read non-ghost, active profiles for discovery
      allow read: if isSignedIn();

      // Only the owner can create their own document
      allow create: if isSignedIn()
                    && isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.status == 'active'
                    && request.resource.data.reportCount == 0
                    && request.resource.data.dailyMessageCount == 0
                    && request.resource.data.isGhostMode == false;

      // Owner can update their own profile fields (but not status/reportCount directly)
      allow update: if isSignedIn()
                    && isOwner(uid)
                    && (
                      // Allow profile updates (username, bio, tags, avatar, location, ghost mode)
                      !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['reportCount', 'status', 'uid'])
                      ||
                      // Allow incrementing dailyMessageCount (done in transaction)
                      (
                        request.resource.data.dailyMessageCount == resource.data.dailyMessageCount + 1
                        && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['reportCount', 'status', 'uid'])
                      )
                    );

      // No one can delete user documents
      allow delete: if false;
    }


    // ─────────────────────────────────────────────
    // /swipes/{swipeId}
    // Composite key format: swiperId_targetId
    // ─────────────────────────────────────────────
    match /swipes/{swipeId} {

      // Swipers can read their own swipe records (to check mutual likes)
      allow read: if isSignedIn()
                  && (resource.data.swiperId == request.auth.uid
                   || resource.data.targetId == request.auth.uid);

      // Only the swiper can create a swipe for themselves
      allow create: if isSignedIn()
                    && request.resource.data.swiperId == request.auth.uid
                    && isActive(request.auth.uid)
                    && request.resource.data.type in ['like', 'pass']
                    && request.resource.data.keys().hasAll(['swiperId', 'targetId', 'type', 'timestamp'])
                    // Swipe ID must match the composite pattern swiperId_targetId
                    && swipeId == request.resource.data.swiperId + '_' + request.resource.data.targetId;

      // Swipes are immutable once cast
      allow update: if false;
      allow delete: if false;
    }


    // ─────────────────────────────────────────────
    // /chats/{chatId}
    // ─────────────────────────────────────────────
    match /chats/{chatId} {

      // Only participants can read a chat
      allow read: if isSignedIn()
                  && isChatParticipant(resource.data);

      // Chats are created by the system (via mutual like logic) — allow if caller
      // is one of the two participants and the doc is properly structured
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && request.resource.data.status in ['active']
                    && request.resource.data.messageCount == 0
                    && request.resource.data.keys().hasAll([
                        'participants', 'createdAt', 'expiresAt',
                        'status', 'messageCount'
                       ]);

      // Participants can update chat status (unlock, expire) and verdicts
      allow update: if isSignedIn()
                    && isChatParticipant(resource.data)
                    // Only allowed field changes: status, verdicts, lastMessageTimestamp, messageCount
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'verdicts', 'lastMessageTimestamp', 'messageCount'])
                    // Status can only move forward: active → unlocked or active → expired
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
                      || (resource.data.status == 'active'
                          && request.resource.data.status in ['unlocked', 'expired'])
                      || resource.data.status == 'unlocked'
                    );

      allow delete: if false;


      // ─────────────────────────────────────────────
      // /chats/{chatId}/messages/{messageId}
      // ─────────────────────────────────────────────
      match /messages/{messageId} {

        // Only participants can read messages
        allow read: if isSignedIn()
                    && isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data);

        // Participant can send a message if:
        // - Chat is not expired (or is unlocked)
        // - They are active (not suspended)
        // - Daily message count is under 20
        allow create: if isSignedIn()
                      && request.resource.data.senderId == request.auth.uid
                      && isActive(request.auth.uid)
                      && isChatParticipant(
                           get(/databases/$(database)/documents/chats/$(chatId)).data
                         )
                      && chatIsNotExpired(
                           get(/databases/$(database)/documents/chats/$(chatId)).data
                         )
                      && withinDailyMessageLimit(request.auth.uid)
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500
                      && request.resource.data.keys().hasAll(['senderId', 'text', 'timestamp']);

        // Messages are immutable
        allow update: if false;
        allow delete: if false;
      }
    }


    // ─────────────────────────────────────────────
    // /reports/{reportId}
    // ─────────────────────────────────────────────
    match /reports/{reportId} {

      // Only admins should read reports (restrict all client reads)
      allow read: if false;

      // Any active signed-in user can file a report
      allow create: if isSignedIn()
                    && isActive(request.auth.uid)
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.reportedId != request.auth.uid
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() > 0
                    && request.resource.data.keys().hasAll([
                        'reporterId', 'reportedId', 'reason', 'timestamp'
                       ]);

      // Reports are immutable
      allow update: if false;
      allow delete: if false;
    }


    // ─────────────────────────────────────────────
    // /happyHourQueue/active
    // Global queue node for Happy Hour matchmaking
    // ─────────────────────────────────────────────
    match /happyHourQueue/{docId} {

      allow read: if isSignedIn();

      // Any active user can join/leave the queue
      allow create, update: if isSignedIn()
                             && isActive(request.auth.uid);

      allow delete: if false;
    }

  }
}
